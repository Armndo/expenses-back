# Copy to scripts/copy-db.env (git-ignored) and fill in. One block per profile: <NAME>_HOST, _PORT, _USER, _DB and
# optionally _PASSWORD (or leave it empty and use ~/.pgpass). Use the profile names with scripts/copy-db.sh:
#
#   scripts/copy-db.sh pro dev      # on the server: both databases on the same host
#   scripts/copy-db.sh pro local    # from a laptop: remote pro -> local dev
#
# The "pro" profile can be read from but never written to.

# Production, read from the server itself (use the remote host/port instead when running from a laptop,
# e.g. through an SSH tunnel: ssh -N -L 5433:127.0.0.1:5432 user@server  and then PRO_HOST=127.0.0.1 PRO_PORT=5433)
PRO_HOST=127.0.0.1
PRO_PORT=5432
PRO_USER=
PRO_DB=
PRO_PASSWORD=

# Dev database on the server
DEV_HOST=127.0.0.1
DEV_PORT=5432
DEV_USER=
DEV_DB=
DEV_PASSWORD=

# Dev database on your machine
LOCAL_HOST=127.0.0.1
LOCAL_PORT=5432
LOCAL_USER=
LOCAL_DB=
LOCAL_PASSWORD=
